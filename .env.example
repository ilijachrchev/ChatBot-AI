# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# Neon pooled connection (for app queries)
DATABASE_URL=postgresql://user:password@host/db?pgbouncer=true&connection_limit=1
# Neon direct connection (for migrations only)
DIRECT_URL=postgresql://user:password@host/db

# ─────────────────────────────────────────────
# CLERK (Authentication)
# ─────────────────────────────────────────────
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SIGN_IN_URL=/auth/sign-in
CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
# From Clerk Dashboard > Webhooks > Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────
# STRIPE (Billing)
# ─────────────────────────────────────────────
# Use sk_test_... for dev, sk_live_... for production
STRIPE_SECRET=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISH_KEY=pk_test_...
# From Stripe Dashboard > Products (monthly recurring prices)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ULTIMATE_PRICE_ID=price_...
# From Stripe Dashboard > Webhooks > Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────
# OPENAI
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
# Set to 'false' to disable all AI responses (kill switch)
AI_ENABLED=true

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
# Full URL including https:// — used for portal links
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─────────────────────────────────────────────
# REAL-TIME (Socket.IO — separate service)
# ─────────────────────────────────────────────
SOCKET_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Upload service URL (client-side access — same host as socket server)
NEXT_PUBLIC_UPLOAD_URL=https://your-socket-server.com

# ─────────────────────────────────────────────
# PUSHER (via socket server)
# ─────────────────────────────────────────────
PUSHER_APP_ID=...
PUSHER_APP_SECRET=...
PUSHER_APP_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_APP_KEY=...
NEXT_PUBLIC_PUSHER_APP_CLUSTER=mt1

# ─────────────────────────────────────────────
# EMAIL
# ─────────────────────────────────────────────
# Gmail App Password (not your regular password)
NODE_MAILER_EMAIL=noreply@yourdomain.com
NODE_MAILER_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Resend API for campaign emails
RESEND_API_KEY=re_...
ADMIN_EMAIL=admin@yourdomain.com

# ─────────────────────────────────────────────
# UPLOADCARE (File uploads)
# ─────────────────────────────────────────────
NEXT_PUBLIC_UPLOAD_CARE_PUBLIC_KEY=...
UPLOAD_CARE_SECRET_KEY=...

# ─────────────────────────────────────────────
# MICROSERVICES
# ─────────────────────────────────────────────
SCRAPER_SERVICE_URL=http://localhost:3001
UPLOAD_SERVICE_URL=http://localhost:4000

# ─────────────────────────────────────────────
# SECURITY
# Generate values with: openssl rand -hex 32
# ─────────────────────────────────────────────
# Signs OTP verification tokens — KEEP SECRET
OTP_TOKEN_SECRET=
# Shared secret between Next.js app and socket server
SOCKET_SHARED_SECRET=

# ─────────────────────────────────────────────
# MISC
# ─────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
